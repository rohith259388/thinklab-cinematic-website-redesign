{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "thinklab-website",
	"account_id": "3e435eb64685de19ce88077319828541",
	"compatibility_date": "2026-10-30",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"vars": {
		"CMS_ORIGIN": "http://localhost:3000",
		"CMS_SETUP_SECRET": "d6788bddb2d806a903824aae149b10591a40f5ea36ae3f54b1b18e40d992ed92",
		"DEFAULT_ADMIN_EMAIL": "admin@thinklab.com",
		"DEFAULT_ADMIN_PASSWORD": "AdminThinkLab2026!",
		"MONGODB_URI": "mongodb+srv://samhith_db_user:SamhithThinklabs%40123@cluster0.hkuapuu.mongodb.net/thinklab?retryWrites=true&w=majority",
		"NEXT_PUBLIC_GOOGLE_CLIENT_ID": "325993927136-77ovcct1qf1j8l3mfqukg9guqq0tdnmn.apps.googleusercontent.com"
	},
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "thinklab-website"
		}
	],
	"r2_buckets": [
		// Use R2 incremental cache
		// See https://opennext.js.org/cloudflare/caching
		{
			"binding": "NEXT_INC_CACHE_R2_BUCKET",
			// Create the bucket before deploying
			// You can change the bucket name if you want
			// See https://developers.cloudflare.com/workers/wrangler/commands/#r2-bucket-create
			"bucket_name": "thinklab-website-opennext-cache"
		}
	],
	"images": {
		// Enable image optimization
		// see https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	}
}
