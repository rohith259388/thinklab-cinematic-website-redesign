# MongoDB Atlas database used for enquiries, CMS, and admin auth. Never commit .env.local.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/thinklab?retryWrites=true&w=majority

# Public site origin; MUST match the exact port where you access the site in your browser.
CMS_ORIGIN=http://localhost:3000

# Setup secret (at least 32 characters) for CMS operations.
CMS_SETUP_SECRET=thinklab_cms_setup_secret_min_32_characters_dev


# Google OAuth 2.0 Web Client ID for Google Sign-In
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Admin Email Notifications (Python script using SMTP - unlimited & free)
ADMIN_NOTIFICATION_EMAIL=info@thinklabdigitalsolutions.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM="ThinkLab Studio <info@thinklabdigitalsolutions.com>"
SMTP_SECURE=false
