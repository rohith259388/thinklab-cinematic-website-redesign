# PostgreSQL database used for enquiries and CMS. Never commit .env.local.
# Compatible with local PostgreSQL, Docker, Supabase, Neon, or AWS RDS.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Public site origin; MUST match the exact port where you access the site in your browser.
CMS_ORIGIN=http://localhost:3000

# One-time setup secret (at least 32 characters) for first-time UI setup.
CMS_SETUP_SECRET=thinklab_cms_setup_secret_min_32_characters_dev

# Optional static admin credentials for `npm run seed:admin`
# Note: Password MUST be at least 14 characters long.
DEFAULT_ADMIN_EMAIL=admin@thinklab.com
DEFAULT_ADMIN_PASSWORD=AdminThinkLab2026!
